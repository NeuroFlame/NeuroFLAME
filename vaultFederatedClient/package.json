{
  "name": "@neuroflame/vault",
  "version": "1.1.0",
  "description": "NeuroFLAME vault federated client",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "neuroflame-vault": "dist/cli.js"
  },
  "files": [
    "dist",
    "systemd",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "compile": "tsc",
    "test": "npm run compile && node --test tests/*.test.mjs",
    "start": "npm run compile && node ./dist/cli.js start",
    "start-configured": "npm run compile && node ./dist/cli.js start",
    "prepack": "npm run clean && npm run compile"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "dockerode": "^4.0.2",
    "graphql": "^16.9.0",
    "graphql-ws": "^5.16.0",
    "unzipper": "^0.11.3",
    "winston": "^3.14.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.28",
    "@types/unzipper": "^0.10.9",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.5"
  }
}
