{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["dom", "es2020"],
    "outDir": "./build",
    "rootDir": "./src",
    "types": ["node", "electron"],
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "edge-federated-client": ["../../edgeFederatedClient/dist"],
    },
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/preload.js",
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts",
  ],
}
