{
  "name": "centralapi",
  "version": "1.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "generate-graphql-types": "graphql-codegen --config codegen.yml",
    "convert-typedefs-to-ts": "node ./convert-typedefs-to-ts.js",
    "compile": "tsc",
    "build": "npm run generate-graphql-types && npm run convert-typedefs-to-ts && npm run compile",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "npm run build && node ./dist/index.js",
    "getTokens": "node ./dev-start.js npm run getTokens:raw",
    "getTokens:raw": "npm run build && node ./dist/authentication/getTokens.js",
    "seed": "node ./dev-start.js npm run seed:raw",
    "seed:raw": "npm run build && node ./dist/database/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@graphql-tools/schema": "^10.0.4",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.16.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "resend": "^4.6.0",
    "winston": "^3.14.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@graphql-codegen/typescript-react-apollo": "^4.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.4",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.3"
  }
}
