{
  "name": "centralapi",
  "private": true,
  "version": "1.1.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "generate-graphql-types": "graphql-codegen --config codegen.yml",
    "convert-typedefs-to-ts": "node ./convert-typedefs-to-ts.js",
    "compile": "tsc",
    "build": "npm run generate-graphql-types && npm run convert-typedefs-to-ts && npm run compile",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "npm run build && node ./dist/index.js",
    "getTokens": "node ./dev-start.js npm run getTokens:raw",
    "getTokens:raw": "npm run build && node ./dist/authentication/getTokens.js",
    "seed": "node ./dev-start.js npm run seed:raw",
    "seed:raw": "npm run build && node ./dist/database/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^11.0.9",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "resend": "^6.38.0",
    "winston": "^3.19.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@graphql-codegen/typescript-react-apollo": "^6.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
